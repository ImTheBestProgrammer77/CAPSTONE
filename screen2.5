
#include <Wire.h>
#include <LiquidCrystal_I2C.h>

//adress and dimensions
//20x4 LCD, uses (0x27, 20, 4)
LiquidCrystal_I2C lcd(0x27, 16, 2);
//may need to replace serial adress

//button
const int buttonPin = 2;
int buttonState = 0;

void setup() {
  // put your setup code here, to run once:
  lcd.init();
  lcd.backlight();
  pinMode(buttonPin, INPUT_PULLUP);
}

void loop() {

buttonState = digitalRead(buttonPin);


if (buttonState == LOW){
  
  lcd.setCursor(0,0);
  lcd.print("Christmas:");
  lcd.setCursor(0,1);
  lcd.print("1. Jingle Bells");
  lcd.setCursor(0,2);
  lcd.print("2. Silent Nt. 3. ???");
  delay(5000);
  lcd.clear();
  delay(1000);
  lcd.setCursor(0,0);
  lcd.print("Christan/Worship:");
  lcd.setCursor(0,1);
  lcd.print("1. This Little Light");
  lcd.setCursor(0,2);
  lcd.print("2. Oceans  3. ???");
  delay(5000);
  lcd.clear();
  delay(1000);
  lcd.setCursor(0,0);
  lcd.print("Disney:");
  lcd.setCursor(0,1);
  lcd.print("1. Hakuna Matata");
  lcd.setCursor(0,2);
  lcd.print("2. Let It Go  3. ???");
  delay(5000);
  lcd.clear();
  delay(1000);
} else {
  lcd.setCursor(0,0);
  lcd.print("Pick a Genre:");
  lcd.setCursor(0,1);
  lcd.print("1. Christmas");
  lcd.setCursor(0,2);
  lcd.print("2. Worship 3. Disney");
  delay(150);
  lcd.clear();
  delay(10);
  lcd.setCursor(0,0);
}
}
